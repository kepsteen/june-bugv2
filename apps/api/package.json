{
  "name": "@starter/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-paths",
    "start": "node dist/index.js",
    "script:generate-entries": "tsx src/scripts/generate-entries.ts",
    "script:backfill-memory-embeddings": "tsx src/scripts/backfill-memory-embeddings.ts",
    "script:migrate-tiptap-to-markdown": "tsx src/scripts/migrate-tiptap-to-markdown.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.37",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@neondatabase/serverless": "^1.0.2",
    "@starter/shared": "workspace:*",
    "ai": "^6.0.105",
    "better-auth": "^1.4.18",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "^4.21.2",
    "openai": "^6.25.0",
    "resend": "^6.9.3",
    "stripe": "^22.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.12.0",
    "@vitest/ui": "^4.0.18",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
