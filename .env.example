# Backend Environment Variables (apps/api/.env)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-generate-with-crypto
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:5174

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Vercel AI Gateway (required for AI title generation, memory embeddings, etc.)
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# AWS S3 (for image uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Resend (for transactional emails, e.g. password reset)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=JuneBug <onboarding@resend.dev>

# Frontend Environment Variables (apps/web/.env.local)
# Optional for local dev when API runs on a different port than the Vite dev server.
VITE_API_URL=http://localhost:3000

# --- Railway production (single-service deploy) ---
# Set these in the Railway dashboard. VITE_API_URL is not required — the SPA uses
# relative /api URLs in production when VITE_API_URL is unset.
#
# RAILPACK_NO_SPA=1  (prevents Railpack from serving the Vite SPA via Caddy; Express serves it)
# NODE_ENV=production
# PUBLIC_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# BETTER_AUTH_URL=  (optional; falls back to PUBLIC_URL)
# CLIENT_URL=        (optional; falls back to PUBLIC_URL)
# DATABASE_URL=      (Neon or Railway Postgres connection string)
# BETTER_AUTH_SECRET=
#
# Build/deploy is configured in railway.toml (Railpack builder).
# Migrations run via preDeployCommand; the container starts with pnpm --filter @starter/api start.
#
# GitHub OAuth callback (if enabled):
# https://<your-domain>/api/auth/callback/github
